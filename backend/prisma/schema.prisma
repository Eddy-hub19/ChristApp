generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  /// * Уникальный @username (латиница, нижний регистр).
  username          String             @unique
  /// null для аккаунтов, созданных через Google, пока пользователь не задал пароль.
  password          String?
  createdAt         DateTime           @default(now())
  isActive          Boolean            @default(true)
  avatarUrl         String?
  /// * Отображаемый ник (изначально совпадает с username).
  nickname          String?
  /// * Кастомный цвет текста (#RRGGBB), опционально.
  themeForegroundHex String? @db.VarChar(7)
  /// * Кастомный фон (#RRGGBB), опционально.
  themeBackgroundHex String? @db.VarChar(7)
  /// * Ключ шрифта: `inter` | `achiko` | `bodoni-moda`.
  themeFontKey      String? @db.VarChar(32)
  /// Останній раз «був у мережі» (оновлюється при відключенні WebSocket після grace).
  lastSeenAt        DateTime?
  /// Короткий опис у профілі (видно в чаті / списку).
  bio               String?   @db.VarChar(500)
  /// Стиль пузырей сообщений отправителя (id из config/bubble-styles.ts), по умолчанию "default".
  bubbleStyle       String    @default("default") @db.VarChar(24)
  /// Личные фоны чата: { v, def: {id, dim}, rooms: { [roomKey]: {id, dim} } } (config/chat-prefs.ts). Видны только владельцу.
  chatBackgrounds   Json?
  /// Личные шрифты: { v, ui, msg, size } (config/chat-prefs.ts). Видны только владельцу.
  fontPrefs         Json?
  messages          Message[]
  pushSubscriptions PushSubscription[]
  memberships       RoomMember[]
  roomReadStates    RoomReadState[]
  savedVerses       SavedVerse[]
  reactions         Reaction[]
  refreshSessions   RefreshSession[]
  authIdentities    AuthIdentity[]
  /// false у нового Google-пользователя, пока он не выбрал @username (без этого в приложение не пускаем).
  usernameChosen    Boolean            @default(true)
  voiceListens      VoiceMessageListen[] @relation("VoiceListens")
  avatarLikesReceived AvatarLike[] @relation("AvatarLikeTarget")
  avatarLikesGiven    AvatarLike[] @relation("AvatarLikeLiker")
  hostedWatchRooms    WatchRoom[]       @relation("WatchRoomHost")
  watchMemberships    WatchRoomMember[] @relation("WatchRoomMemberUser")
  watchMessages       WatchMessage[]
  watchMessageReactions WatchMessageReaction[]
  flockProfile        FlockProfile?
  rubyTransactions    RubyTransaction[]  @relation("RubyTxUser")
  flockSkinPurchases  FlockSkinPurchase[]
  flockDailyRecords   FlockDailyRecord[]
  flockStreak         FlockStreak?
  flockArtifactPurchases FlockArtifactPurchase[]
}

/// Лайк аватара: кто (liker) поставил кому (target).
model AvatarLike {
  id           String   @id @default(uuid())
  targetUserId String
  likerUserId  String
  createdAt    DateTime @default(now())
  targetUser   User     @relation("AvatarLikeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  likerUser    User     @relation("AvatarLikeLiker", fields: [likerUserId], references: [id], onDelete: Cascade)

  @@unique([targetUserId, likerUserId])
  @@index([targetUserId])
}

/// Внешний способ входа (сейчас только Google). `providerId` = Google `sub`; email показываем лишь владельцу.
model AuthIdentity {
  id         String   @id @default(cuid())
  userId     String
  provider   String   @db.VarChar(16)
  providerId String   @db.VarChar(64)
  email      String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@index([userId])
}

/// * Opaque refresh token (хеш в БД, сырое значение только в HttpOnly-куке).
model RefreshSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// After rotation, old row is kept ~30s so a duplicate refresh with the same cookie replays the same access JWT.
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  graceAccessToken String?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRevoked, revokedAt])
}

enum MessageType {
  TEXT
  VOICE
  IMAGE
  FILE
  VIDEO_NOTE
}

model Message {
  id        String      @id @default(uuid())
  type      MessageType @default(TEXT)
  content   String?
  fileUrl   String?
  voiceDuration Float?
  /// Розміри зображення (px) — щоб чат резервував місце до завантаження.
  mediaWidth  Int?
  mediaHeight Int?
  /// Розмір вкладення в байтах (файли).
  fileSize    Int?
  /// Повідомлення, на яке це є відповіддю (без FK: після видалення оригіналу цитата лишається з позначкою "видалено").
  replyToId String?
  senderId  String
  /// Ідентифікатор відправки з клієнта: повтор із тим самим id не створює дубль (ідемпотентність), ехо несе його назад.
  clientMessageId String?
  createdAt DateTime    @default(now())
  roomId    String      @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  room      Room        @relation(fields: [roomId], references: [id])
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  voiceListens VoiceMessageListen[]

  @@unique([senderId, clientMessageId])
  @@index([roomId, createdAt])
}

model VoiceMessageListen {
  id        String    @id @default(uuid())
  messageId String
  userId    String
  listenedAt DateTime @default(now())
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User      @relation("VoiceListens", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, type])
  @@index([messageId, createdAt])
}

model Room {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String          @unique
  createdAt  DateTime        @default(now())
  messages   Message[]
  members    RoomMember[]
  readStates RoomReadState[]
}

model RoomMember {
  roomId   String   @db.Uuid
  userId   String
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model SavedVerse {
  id          String   @id @default(uuid())
  userId      String
  book        String
  chapter     Int
  verse       Int
  text        String
  translation String
  savedAt     DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter, verse, translation])
  @@index([userId, savedAt])
}

model RoomReadState {
  roomId     String   @db.Uuid
  userId     String
  lastReadAt DateTime @default(dbgenerated("to_timestamp((0)::double precision)"))
  updatedAt  DateTime @updatedAt
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId, lastReadAt])
}

model PushSubscription {
  id             String    @id @default(cuid())
  userId         String
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastUsedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

enum WatchMemberStatus {
  INVITED
  JOINED
}

/// Джерело відео в кімнаті. YOUTUBE/VIMEO/DAILYMOTION/FILE — повна синхронізація (програмне
/// керування плеєром). IFRAME/MANUAL — ручна синхронізація (відлік і "я готовий" замість команд
/// play/pause/seek): IFRAME показує сторінку у вбудованому iframe, MANUAL — лише прев'ю й посилання
/// "Відкрити" (сайт заборонив вбудовування). Визначається автоматично сервером при вставці посилання.
enum WatchProvider {
  YOUTUBE
  VIMEO
  DAILYMOTION
  FILE
  IFRAME
  MANUAL
}

/// Кімната «Кіношка з Ісусом»: спільний перегляд відео з кількох джерел. Стан плеєра — єдине джерело правди на сервері.
model WatchRoom {
  id             String            @id @default(uuid())
  title          String            @db.VarChar(80)
  provider       WatchProvider     @default(YOUTUBE)
  /// YouTube/Vimeo/Dailymotion — id відео; FILE/IFRAME/MANUAL — повний URL.
  videoId        String            @db.VarChar(2048)
  /// Назва відео (з oEmbed чи іншого джерела метаданих); може бути порожньою.
  videoTitle     String?           @db.VarChar(200)
  /// Обкладинка для прев'ю картки кімнати; є не в усіх провайдерів (напр. FILE).
  thumbnailUrl   String?           @db.VarChar(1024)
  isPlaying      Boolean           @default(false)
  /// Позиція (с) на момент `stateUpdatedAt`; під час відтворення поточна = position + (now − stateUpdatedAt).
  positionSec    Float             @default(0)
  stateUpdatedAt DateTime          @default(now())
  hostId         String
  /// Секрет для посилання-запрошення: будь-хто залогінений із ним стає учасником.
  inviteToken    String            @unique
  createdAt      DateTime          @default(now())
  host           User              @relation("WatchRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  members        WatchRoomMember[]
  messages       WatchMessage[]

  @@index([hostId])
}

model WatchRoomMember {
  roomId      String
  userId      String
  status      WatchMemberStatus @default(INVITED)
  invitedById String?
  createdAt   DateTime          @default(now())
  /// Коли прийняв запрошення — порядок для автопередачі керування.
  joinedAt    DateTime?
  /// До якого моменту учасник переглянув повідомлення чату кімнати (як RoomReadState.lastReadAt).
  lastReadAt         DateTime  @default(dbgenerated("to_timestamp((0)::double precision)"))
  /// Учасник вимкнув пуш-сповіщення для цієї кімнати.
  notificationsMuted Boolean   @default(false)
  room        WatchRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User              @relation("WatchRoomMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId, status])
}

/// TEXT — звичайне повідомлення; SYSTEM — службовий рядок (вихід/вхід учасника), текст збирає клієнт.
enum WatchMessageType {
  TEXT
  SYSTEM
}

model WatchMessage {
  id        String    @id @default(uuid())
  roomId    String
  userId    String
  /// Для SYSTEM порожній: уся інформація в `systemData`.
  content   String    @db.VarChar(500)
  type      WatchMessageType @default(TEXT)
  /// Лише для SYSTEM: { event: "left" | "joined" | "back", at, wasHost?, toUserId?, paused? }.
  systemData Json?
  /// Повідомлення чату Киношки, на яке це є відповіддю (без FK — як Message.replyToId).
  replyToId String?
  /// Коли автор востаннє редагував повідомлення (null — не редагувалось).
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  room      WatchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions WatchMessageReaction[]

  @@index([roomId, createdAt])
}

model WatchMessageReaction {
  id        String       @id @default(uuid())
  userId    String
  messageId String
  type      String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   WatchMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, type])
  @@index([messageId, createdAt])
}

/// Профіль гри «Отара»: баланс рубінів (кеш суми журналу) і статистика. Створюється при першому зверненні.
model FlockProfile {
  userId          String    @id
  /// Баланс змінюється лише разом із записом у RubyTransaction (одна транзакція).
  rubies          Int       @default(0)
  bestMass        Int       @default(0)
  eaten           Int       @default(0)
  topMs           BigInt    @default(0)
  games           Int       @default(0)
  /// Коли статистику з localStorage перенесли на сервер (один раз).
  statsImportedAt DateTime?
  selectedSkin    Int       @default(0)
  /// Надітий артефакт (0 - нічого; 1..7). Бонус рахує сервер при вході на арену.
  selectedArtifact Int      @default(0)
  /// Остання переглянута версія плашки «Що нового» (щоб не показувати повторно на іншому пристрої).
  whatsNewSeen    Int       @default(0)
  /// Коли гравець отримав разовий бонус за перший вхід у гру (null - ще ні).
  entryBonusAt    DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RubyReason {
  ARENA_TOP1
  SKIN_PURCHASE
  ADMIN_ADJUST
  ENTRY_BONUS
  ARTIFACT_PURCHASE
  ARENA_BOSS
  ARENA_STREAK
}

/// Журнал рубінів: тільки додавання рядків.
model RubyTransaction {
  id           String     @id @default(uuid())
  userId       String
  delta        Int
  balanceAfter Int
  reason       RubyReason
  /// Причина від адміна.
  note         String?
  skinId       Int?
  artifactId   Int?
  /// Хто ініціював (адмін), якщо не сама гра.
  actorId      String?
  createdAt    DateTime   @default(now())
  user         User       @relation("RubyTxUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, reason, createdAt])
}

model FlockSkinPurchase {
  userId    String
  skinId    Int
  price     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skinId])
}

/// Куплені артефакти «Отари» (як FlockSkinPurchase).
model FlockArtifactPurchase {
  userId     String
  artifactId Int
  price      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, artifactId])
}

/// Найбільша маса гравця за добу (доба за часом Києва, `day` = "YYYY-MM-DD").
model FlockDailyRecord {
  day       String
  userId    String
  maxMass   Int
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([day, userId])
  @@index([day, maxMass(sort: Desc)])
}

/// Підсумок закритої доби; наявність рядка = доба вже пораховано (захист від повторного нарахування).
model FlockDayWinner {
  day      String   @id
  /// null - ніхто не набрав мінімальну масу.
  userId   String?
  maxMass  Int      @default(0)
  closedAt DateTime @default(now())
}

/// Серія днів поспіль на 1-му місці (один рядок на поточного лідера).
model FlockStreak {
  userId       String @id
  days         Int
  lastDay      String
  /// Видані, але ще не показані гравцю рубіни за серію (скидається при показі).
  pendingAward Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
